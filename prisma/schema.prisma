// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum OccupationType {
  ACTIVE_PRO_ATHLETE
  RETIRED_ATHLETE
  RETIRED_COACH
  COACH
  FRONT_OFFICE
  BROADCASTER_ANALYST
  ENTREPRENEUR_BUSINESS
  STUDENT
  OTHER
}

enum Role {
  PLAYER
  HEAD_COACH
  ASSISTANT_COACH
  MANAGER
}

enum StatLevel {
  HIGH_SCHOOL
  COLLEGE
  PROFESSIONAL
  COACHING
}

model Team {
  id             Int              @id @default(autoincrement())
  slug           String           @unique
  name           String
  season         String
  sport          String
  school         String
  conference     String?
  accomplishment String?
  logoUrl        String?
  mascotName     String?
  memberships    TeamMembership[]
  createdAt      DateTime         @default(now())
}

model Person {
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  firstName     String
  lastName      String
  birthYear     Int?
  hometown      String?
  highSchool    String?
  imageUrl        String?
  collegeImageUrl String?
  bio             String?
  isFeatured    Boolean          @default(false)
  memberships   TeamMembership[]
  currentStatus CurrentStatus?
  careerEvents  CareerEvent[]
  seasonStats   SeasonStats[]
  location      PlayerLocation?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model CurrentStatus {
  id              Int            @id @default(autoincrement())
  personId        Int            @unique
  person          Person         @relation(fields: [personId], references: [id])
  occupationType  OccupationType
  currentTitle    String?
  currentEmployer String?
  league          String?
  location        String?
  statusNote      String?
  asOfDate        DateTime?
  sourceUrl       String?
  linkedInUrl     String?
}

model TeamMembership {
  id              Int     @id @default(autoincrement())
  personId        Int
  teamId          Int
  person          Person  @relation(fields: [personId], references: [id])
  team            Team    @relation(fields: [teamId], references: [id])
  role            Role
  jerseyNumber    Int?
  position        String?
  yearsAtSchool   String?
  statsNote       String?
  gamesPlayed     Int?
  pointsPerGame   Float?
  reboundsPerGame Float?
  assistsPerGame  Float?

  @@unique([personId, teamId])
}

model SeasonStats {
  id               Int       @id @default(autoincrement())
  personId         Int
  person           Person    @relation(fields: [personId], references: [id])
  level            StatLevel
  teamName         String
  season           String
  yearLabel        String
  sortOrder        Int
  gamesPlayed      Int?
  minutesPerGame   Float?
  pointsPerGame    Float?
  reboundsPerGame  Float?
  assistsPerGame   Float?
  stealsPerGame    Float?
  blocksPerGame    Float?
  fieldGoalPct     Float?
  threePointPct    Float?
  freeThrowPct     Float?
  wins             Int?
  losses           Int?
  tournamentResult String?
}

model CareerEvent {
  id        Int      @id @default(autoincrement())
  personId  Int
  person    Person   @relation(fields: [personId], references: [id])
  year      Int
  month     Int?
  day       Int?
  title     String
  eventType String?
  detail    String?
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Submission {
  id          Int              @id @default(autoincrement())
  personSlug  String?
  personName  String?
  submitterName  String?
  submitterEmail String?
  field       String
  currentValue String?
  suggestedValue String
  reason      String?
  sourceUrl   String?
  status      SubmissionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  reviewedAt  DateTime?
}

model PlayerLocation {
  id        Int     @id @default(autoincrement())
  personId  Int     @unique
  person    Person  @relation(fields: [personId], references: [id])
  city      String
  region    String?
  country   String  @default("USA")
  latitude  Float
  longitude Float
}

model PlayerUpdate {
  id          Int      @id @default(autoincrement())
  personId    Int
  field       String
  oldValue    String?
  newValue    String?
  source      String
  detectedAt  DateTime @default(now())
}
